{
  "name": "kaoruko-waguri",
  "version": "5.0.0",
  "description": "Kaoruko Waguri - Bot de Telegram em ESM com OKARUN API e SQLite",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test",
    "restaurar": "node scripts/restaurar.js",
    "test:ui": "node scripts/teste-interface.mjs",
    "catalogo:telegram": "node scripts/catalogo-telegram.mjs",
    "test:types": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext scripts/verificar-tipos-telegram.ts",
    "test:platform-ui": "node scripts/teste-plataforma-ui.mjs"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "better-sqlite3": "^12.11.1",
    "cfonts": "^3.3.0",
    "chalk": "^5.4.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ms": "^2.1.3",
    "node-cron": "^4.6.0",
    "telegraf": "^4.16.3"
  },
  "keywords": [
    "telegram",
    "bot",
    "esm",
    "okarun",
    "kaoruko",
    "sqlite"
  ],
  "license": "MIT",
  "devDependencies": {
    "@grammyjs/types": "^5.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "playwright": "^1.64.1",
    "typescript": "^5.7.3"
  }
}
