BOT_TOKEN=COLE_SEU_TOKEN_AQUI
BOT_NAME=Kaoruko Waguri
BOT_PREFIX="/,#"
BOT_OWNERS=SEU_ID_TELEGRAM

OKARUN_APIKEY=COLE_SUA_APIKEY_AQUI
OKARUN_BASE_URL=https://api.okarunsystem.com.br
OKARUN_TIMEOUT=60000

PAINEL_ENABLED=true
PAINEL_PORT=4091
PAINEL_URL=
PAINEL_ADMIN_EMAIL=
PAINEL_ADMIN_SENHA=
PAINEL_REGISTRO_ABERTO=false

GROUP_LINK=
BOT_TZ=America/Sao_Paulo

ASSET_HEADER=https://res.cloudinary.com/wagurinuvem/image/upload/v1785035523/waguri/fotomenu_1785035522128_jpg_1785035522132_f4jita.jpg
ASSET_MENU=https://res.cloudinary.com/wagurinuvem/image/upload/v1785035523/waguri/fotomenu_1785035522128_jpg_1785035522132_f4jita.jpg
ASSET_ERRO=https://res.cloudinary.com/wagurinuvem/image/upload/v1785035523/waguri/fotomenu_1785035522128_jpg_1785035522132_f4jita.jpg

# Opcional: caminho do banco e pasta dos backups (nao versionar).
# DATABASE_PATH=database/kaoruko.db
# BACKUP_DIR=database/backups
# Em producao, configure PAINEL_URL=https://seu-dominio e use um proxy HTTPS.

# Plataforma Telegram 5.0 — modulos opcionais DESLIGADOS por padrao.
TELEGRAM_INLINE_ENABLED=false
TELEGRAM_MINI_APP_ENABLED=false
TELEGRAM_MINI_APP_URL=
TELEGRAM_STARS_ENABLED=false
TELEGRAM_TERMS_URL=
TELEGRAM_PAY_SUPPORT=
TELEGRAM_BUSINESS_ENABLED=false
# polling OU webhook. Nao execute ambos com o mesmo token.
TELEGRAM_TRANSPORT=polling
# Exemplo de URL: https://seu-dominio/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Gere um segredo independente do token da bot com: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
